BOT_TOKEN="123456789:replace-me"
ZABBIX_URL="http://zabbix.example.com/zabbix"
ZABBIX_TOKEN="replace-me"
ZABBIX_USER="Admin"
ZABBIX_PASS="replace-me"
ZABBIX_NETWORK_CHART_ID="0000"
ADMIN_IDS="111111111,222222222"
ADMIN_NICKNAMES="admin1,admin2"
# При запуске через docker compose DB_URL переопределяется в docker-compose.yml
DB_URL="sqlite+aiosqlite:///bot.db"
MONTHLY_FEE='60'
PAYMENT_DAY='2'
REMIND_BEFORE_DAYS="0"
REMIND_INTERVAL_DAYS="7"
ADMIN_PHONES="79990000000"
HELP_GIST_URL="https://github.com/your-name/ProxyClientGuides/blob/main/MainGuide.md"
CONFIG_GIST_URL="https://gist.github.com/your-name/your-gist-id"
CACHE_TTL="60"
SUBSCRIBE_ENDPOINT="https://sub.example.com/sub/"
# Часовой пояс контейнера (используется docker compose), по умолчанию Europe/Moscow
# TZ="Europe/Moscow"
